# Database (Neon PostgreSQL)
# Pooled connection string for application runtime queries
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"
# Direct connection string for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require"

# App & Authentication
NODE_ENV="development"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-hex-secret-for-jwt"

# AI Service (Google Gemini - Server-side only, never client-side)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_EXTRACTION_MODEL="gemini-1.5-flash"
GEMINI_JUDGE_MODEL="gemini-1.5-pro"

# Private Storage Configuration
# "local" for offline local dev/testing (stored outside public/ in storage/), "s3" for Cloudflare R2 / AWS S3
STORAGE_DRIVER="local"

# Document Upload & Processing Limits
MAX_DOCUMENT_SIZE_MB="10"
MAX_DOCUMENT_PAGES="100"
MAX_PROJECT_DOCUMENTS="50"
# S3 / Cloudflare R2 credentials (required only when STORAGE_DRIVER="s3")
S3_BUCKET="continuityx-documents"
S3_REGION="auto"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
