datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectRole {
  OWNER
  REVIEWER
  VIEWER
}

enum TextQuality {
  OK
  LOW_TEXT
  SCANNED_SUSPECTED
}

enum SourceDateBasis {
  USER_PROVIDED
  CONTENT_EXPLICIT
  UNKNOWN
}

enum DocumentProcessingStatus {
  UPLOADED
  VALIDATING
  EXTRACTING
  CHUNKING
  READY_FOR_AI
  AI_PROCESSING
  AI_COMPLETED
  AI_PROCESSING_FAILED
  VALIDATION_FAILED
  EXTRACTION_FAILED
}

enum ProcessingJobState {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ExtractionRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CACHED
}

enum EntityType {
  PERSON
  COMPONENT
  SYSTEM
}

enum EntityCreator {
  MODEL
  REVIEWER
}

enum ClaimCategory {
  DECISION
  TASK
  OWNERSHIP
  DEPENDENCY
  RISK
  OPEN_QUESTION
  FACT
}

enum ReviewState {
  PENDING
  ACCEPTED
  EDITED
  REJECTED
}

enum EvidenceType {
  DIRECT_QUOTE
  TABLE_ROW
  SECTION_EXCERPT
}

enum EvidenceStatus {
  VERIFIED
  WEAK_SUPPORT
  CONFLICTING
  UNVERIFIED
  UNKNOWN
}

enum GateOutcome {
  PASS
  FAIL
}

enum SemanticSupportOutcome {
  SUPPORTS
  NEUTRAL
  CONTRADICTS
  INSUFFICIENT_CONTEXT
}

enum ConflictType {
  STATUS_CONFLICT
  OWNERSHIP_CONFLICT
  DECISION_CONFLICT
  TIMELINE_CONFLICT
  VALUE_CONFLICT
}

enum ConflictResolutionState {
  OPEN
  POSSIBLY_SUPERSEDED
  REQUIRES_CLARIFICATION
  UNDER_REVIEW
  RESOLVED_MUTUAL_ACCEPT
  RESOLVED_ONE_ACCEPTED
  RESOLVED_BOTH_REJECTED
  RESOLVED_EDITED
}

model User {
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  passwordHash      String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  memberships       ProjectMember[]
  createdProjects   Project[]       @relation("ProjectCreator")
  uploadedDocuments Document[]
  auditLogs         AuditLog[]
  reviews           Review[]
  reviewActions     ReviewAction[]
  resolvedConflicts Conflict[]        @relation("ConflictResolver")
  handoversApproved Handover[]        @relation("HandoverApprover")
  handoverReceipts  HandoverReceipt[]

  @@index([email])
}

model Project {
  id             String          @id @default(cuid())
  name           String
  description    String?
  status         ProjectStatus   @default(ACTIVE)
  createdBy      String
  createdByUser  User            @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  members        ProjectMember[]
  documents      Document[]
  extractionRuns ExtractionRun[]
  entities       Entity[]
  claims         Claim[]
  conflicts      Conflict[]
  auditLogs      AuditLog[]
  reviews        Review[]
  reviewActions  ReviewAction[]
  handovers      Handover[]

  @@index([createdBy])
  @@index([status])
  @@index([createdAt])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(VIEWER)
  joinedAt  DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@index([role])
}

model Document {
  id               String                   @id @default(cuid())
  projectId        String
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy       String
  uploadedByUser   User                     @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  fileName         String
  mimeType         String
  storageKey       String
  fileSize         Int
  checksum         String // SHA-256 hash of raw file
  pageCount        Int                      @default(1)
  textQuality      TextQuality              @default(OK)
  sourceDate       DateTime?
  sourceDateBasis  SourceDateBasis          @default(UNKNOWN)
  processingStatus DocumentProcessingStatus @default(UPLOADED)
  deletedAt        DateTime?
  uploadedAt       DateTime                 @default(now())
  chunks           DocumentChunk[]
  processingJobs   ProcessingJob[]
  extractionRuns   ExtractionRun[]
  claimEvidence    ClaimEvidence[]

  @@index([projectId, checksum])
  @@index([projectId])
  @@index([uploadedBy])
  @@index([processingStatus])
  @@index([deletedAt])
  @@index([uploadedAt])
}

model DocumentChunk {
  id            String          @id @default(cuid())
  documentId    String
  document      Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex    Int
  content       String          @db.Text
  pageNumber    Int?
  sectionTitle  String?
  rowStart      Int?
  rowEnd        Int?
  injectionFlag Boolean         @default(false)
  metadata      Json?
  createdAt     DateTime        @default(now())
  claimEvidence ClaimEvidence[]

  @@index([documentId, chunkIndex])
  @@index([pageNumber])
  @@index([injectionFlag])
}

model ProcessingJob {
  id             String             @id @default(cuid())
  documentId     String
  document       Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  state          ProcessingJobState @default(PENDING)
  attempts       Int                @default(0)
  lastError      String?
  stepData       Json?
  leaseExpiresAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([documentId])
  @@index([state])
  @@index([leaseExpiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ExtractionRun {
  id            String              @id @default(cuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  model         String
  promptVersion String
  schemaVersion String
  inputChecksum String
  status        ExtractionRunStatus @default(RUNNING)
  startedAt     DateTime            @default(now())
  finishedAt    DateTime?
  error         String?
  claims        Claim[]

  @@index([projectId, documentId])
  @@index([inputChecksum, promptVersion, model, schemaVersion])
  @@index([status])
}

model Entity {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  canonicalName  String
  normalizedId   String
  type           EntityType
  createdBy      EntityCreator @default(MODEL)
  mergedIntoId   String?
  mergedInto     Entity?       @relation("EntityMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedEntities Entity[]      @relation("EntityMerge")
  needsReview    Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  aliases        EntityAlias[]
  claims         Claim[]
  conflicts      Conflict[]

  @@unique([projectId, normalizedId])
  @@index([projectId, type])
  @@index([mergedIntoId])
  @@index([needsReview])
}

model EntityAlias {
  id              String   @id @default(cuid())
  entityId        String
  entity          Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  alias           String
  normalizedAlias String
  createdAt       DateTime @default(now())

  @@unique([entityId, normalizedAlias])
  @@index([normalizedAlias])
}

model Claim {
  id                String          @id @default(cuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subjectEntityId   String
  subjectEntity     Entity          @relation(fields: [subjectEntityId], references: [id], onDelete: Restrict)
  attributeKey      String
  valueRaw          String          @db.Text
  valueNormalized   String?
  category          ClaimCategory
  reviewState       ReviewState     @default(PENDING)
  version           Int             @default(1)
  supersedesClaimId String?
  supersedesClaim   Claim?          @relation("ClaimVersion", fields: [supersedesClaimId], references: [id], onDelete: SetNull)
  supersededBy      Claim[]         @relation("ClaimVersion")
  extractionRunId   String?
  extractionRun     ExtractionRun?  @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)
  injectionFlag     Boolean         @default(false)
  confidence        Float? // Advisory only; never used to derive evidence status
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  evidence          ClaimEvidence[]
  verifications     Verification[]
  conflictsAsA      Conflict[]      @relation("ConflictClaimA")
  conflictsAsB      Conflict[]      @relation("ConflictClaimB")
  reviews           Review[]

  @@index([projectId, subjectEntityId, attributeKey])
  @@index([projectId, category, reviewState])
  @@index([extractionRunId])
  @@index([injectionFlag])
  @@index([supersedesClaimId])
}

model ClaimEvidence {
  id             String        @id @default(cuid())
  claimId        String
  claim          Claim         @relation(fields: [claimId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkId        String
  chunk          DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  sourceLocation String
  excerpt        String        @db.Text
  evidenceType   EvidenceType  @default(DIRECT_QUOTE)
  createdAt      DateTime      @default(now())

  @@index([claimId])
  @@index([documentId, chunkId])
}

model Verification {
  id                 String                  @id @default(cuid())
  claimId            String
  claim              Claim                   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  status             EvidenceStatus
  sourceGate         GateOutcome
  sourceGateReason   String?
  quoteGate          GateOutcome
  quoteGateReason    String?
  quoteSimilarity    Float?
  semanticGate       SemanticSupportOutcome?
  semanticReason     String?                 @db.Text
  contradictionGate  GateOutcome
  contradictionCount Int                     @default(0)
  ruleSetVersion     String                  @default("v3.2")
  judgeModel         String?
  judgePromptVersion String?
  rawJudgeOutput     Json?
  verifiedAt         DateTime                @default(now())
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([claimId])
  @@index([status])
  @@index([verifiedAt])
}

model Conflict {
  id               String                  @id @default(cuid())
  projectId        String
  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subjectEntityId  String
  subjectEntity    Entity                  @relation(fields: [subjectEntityId], references: [id], onDelete: Restrict)
  attributeKey     String
  claimAId         String
  claimA           Claim                   @relation("ConflictClaimA", fields: [claimAId], references: [id], onDelete: Cascade)
  claimBId         String
  claimB           Claim                   @relation("ConflictClaimB", fields: [claimBId], references: [id], onDelete: Cascade)
  conflictType     ConflictType
  status           ConflictResolutionState @default(OPEN)
  resolutionNotes  String?                 @db.Text
  resolvedByUserId String?
  resolvedByUser   User?                   @relation("ConflictResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([claimAId, claimBId])
  @@index([projectId, status])
  @@index([subjectEntityId, attributeKey])
  @@index([claimAId])
  @@index([claimBId])
}

enum ReviewDecision {
  ACCEPTED
  REJECTED
  EDITED
  NEEDS_CLARIFICATION
}

enum ReviewActionType {
  CLAIM_ACCEPTED
  CLAIM_REJECTED
  CLAIM_EDITED
  CONFLICT_RESOLVED
  ENTITIES_MERGED
}

model Review {
  id         String         @id @default(cuid())
  claimId    String
  claim      Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  decision   ReviewDecision
  comments   String?        @db.Text
  reviewedAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  actions    ReviewAction[]

  @@index([claimId])
  @@index([projectId])
  @@index([reviewerId])
  @@index([decision])
}

model ReviewAction {
  id          String           @id @default(cuid())
  reviewId    String?
  review      Review?          @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  actionType  ReviewActionType
  targetId    String
  targetType  String // CLAIM, CONFLICT, ENTITY
  beforeState Json?
  afterState  Json?
  reason      String?          @db.Text
  createdAt   DateTime         @default(now())

  @@index([projectId])
  @@index([userId])
  @@index([targetId])
  @@index([actionType])
}

model HealthCheck {
  id        String   @id @default(cuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now())
}

enum HandoverStatus {
  DRAFT
  APPROVED
}

model Handover {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version      Int
  status       HandoverStatus    @default(DRAFT)
  title        String
  summary      String?           @db.Text
  generatedAt  DateTime          @default(now())
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?             @relation("HandoverApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  snapshot     HandoverSnapshot?
  receipt      HandoverReceipt?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([projectId, version])
  @@index([projectId, status])
  @@index([projectId, version])
}

model HandoverSnapshot {
  id                      String   @id @default(cuid())
  handoverId              String   @unique
  handover                Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  canonicalJson           String   @db.Text
  schemaVersion           Int      @default(1)
  canonicalisationVersion Int      @default(1)
  createdAt               DateTime @default(now())

  @@index([handoverId])
}

model HandoverReceipt {
  id                      String   @id @default(cuid())
  handoverId              String   @unique
  handover                Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  version                 Int
  snapshotHash            String // SHA-256 hex string (64 chars)
  previousReceiptHash     String? // SHA-256 hex string or null
  approvedById            String
  approvedBy              User     @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt              DateTime @default(now())
  canonicalisationVersion Int      @default(1)

  @@index([handoverId])
  @@index([snapshotHash])
  @@index([version])
}
