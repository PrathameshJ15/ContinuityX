datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectRole {
  OWNER
  REVIEWER
  VIEWER
}

enum TextQuality {
  OK
  LOW_TEXT
  SCANNED_SUSPECTED
}

enum SourceDateBasis {
  USER_PROVIDED
  CONTENT_EXPLICIT
  UNKNOWN
}

enum DocumentProcessingStatus {
  UPLOADED
  VALIDATING
  EXTRACTING
  CHUNKING
  READY_FOR_AI
  AI_PROCESSING
  AI_COMPLETED
  AI_PROCESSING_FAILED
  VALIDATION_FAILED
  EXTRACTION_FAILED
}

enum ProcessingJobState {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ExtractionRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CACHED
}

enum EntityType {
  PERSON
  COMPONENT
  SYSTEM
}

enum EntityCreator {
  MODEL
  REVIEWER
}

enum ClaimCategory {
  DECISION
  TASK
  OWNERSHIP
  DEPENDENCY
  RISK
  OPEN_QUESTION
  FACT
}

enum ReviewState {
  PENDING
  ACCEPTED
  EDITED
  REJECTED
}

enum EvidenceType {
  DIRECT_QUOTE
  TABLE_ROW
  SECTION_EXCERPT
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  passwordHash    String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  memberships     ProjectMember[]
  createdProjects Project[]       @relation("ProjectCreator")
  uploadedDocuments Document[]
  auditLogs       AuditLog[]

  @@index([email])
}

model Project {
  id            String          @id @default(cuid())
  name          String
  description   String?
  status        ProjectStatus   @default(ACTIVE)
  createdBy     String
  createdByUser User            @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  members        ProjectMember[]
  documents      Document[]
  extractionRuns ExtractionRun[]
  entities       Entity[]
  claims         Claim[]
  auditLogs      AuditLog[]

  @@index([createdBy])
  @@index([status])
  @@index([createdAt])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(VIEWER)
  joinedAt  DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@index([role])
}

model Document {
  id               String                   @id @default(cuid())
  projectId        String
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy       String
  uploadedByUser   User                     @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  fileName         String
  mimeType         String
  storageKey       String
  fileSize         Int
  checksum         String                   // SHA-256 hash of raw file
  pageCount        Int                      @default(1)
  textQuality      TextQuality              @default(OK)
  sourceDate       DateTime?
  sourceDateBasis  SourceDateBasis          @default(UNKNOWN)
  processingStatus DocumentProcessingStatus @default(UPLOADED)
  deletedAt        DateTime?
  uploadedAt       DateTime                 @default(now())
  chunks           DocumentChunk[]
  processingJobs   ProcessingJob[]
  extractionRuns   ExtractionRun[]
  claimEvidence    ClaimEvidence[]

  @@index([projectId, checksum])
  @@index([projectId])
  @@index([uploadedBy])
  @@index([processingStatus])
  @@index([deletedAt])
  @@index([uploadedAt])
}

model DocumentChunk {
  id            String          @id @default(cuid())
  documentId    String
  document      Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex    Int
  content       String          @db.Text
  pageNumber    Int?
  sectionTitle  String?
  rowStart      Int?
  rowEnd        Int?
  injectionFlag Boolean         @default(false)
  metadata      Json?
  createdAt     DateTime        @default(now())
  claimEvidence ClaimEvidence[]

  @@index([documentId, chunkIndex])
  @@index([pageNumber])
  @@index([injectionFlag])
}

model ProcessingJob {
  id             String             @id @default(cuid())
  documentId     String
  document       Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  state          ProcessingJobState @default(PENDING)
  attempts       Int                @default(0)
  lastError      String?
  stepData       Json?
  leaseExpiresAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([documentId])
  @@index([state])
  @@index([leaseExpiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ExtractionRun {
  id            String              @id @default(cuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  model         String
  promptVersion String
  schemaVersion String
  inputChecksum String
  status        ExtractionRunStatus @default(RUNNING)
  startedAt     DateTime            @default(now())
  finishedAt    DateTime?
  error         String?
  claims        Claim[]

  @@index([projectId, documentId])
  @@index([inputChecksum, promptVersion, model, schemaVersion])
  @@index([status])
}

model Entity {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  canonicalName  String
  normalizedId   String
  type           EntityType
  createdBy      EntityCreator @default(MODEL)
  mergedIntoId   String?
  mergedInto     Entity?       @relation("EntityMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedEntities Entity[]      @relation("EntityMerge")
  needsReview    Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  aliases        EntityAlias[]
  claims         Claim[]

  @@unique([projectId, normalizedId])
  @@index([projectId, type])
  @@index([mergedIntoId])
  @@index([needsReview])
}

model EntityAlias {
  id              String   @id @default(cuid())
  entityId        String
  entity          Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  alias           String
  normalizedAlias String
  createdAt       DateTime @default(now())

  @@unique([entityId, normalizedAlias])
  @@index([normalizedAlias])
}

model Claim {
  id                String          @id @default(cuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subjectEntityId   String
  subjectEntity     Entity          @relation(fields: [subjectEntityId], references: [id], onDelete: Restrict)
  attributeKey      String
  valueRaw          String          @db.Text
  valueNormalized   String?
  category          ClaimCategory
  reviewState       ReviewState     @default(PENDING)
  version           Int             @default(1)
  supersedesClaimId String?
  supersedesClaim   Claim?          @relation("ClaimVersion", fields: [supersedesClaimId], references: [id], onDelete: SetNull)
  supersededBy      Claim[]         @relation("ClaimVersion")
  extractionRunId   String?
  extractionRun     ExtractionRun?  @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)
  injectionFlag     Boolean         @default(false)
  confidence        Float?          // Advisory only; never used to derive evidence status
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  evidence          ClaimEvidence[]

  @@index([projectId, subjectEntityId, attributeKey])
  @@index([projectId, category, reviewState])
  @@index([extractionRunId])
  @@index([injectionFlag])
  @@index([supersedesClaimId])
}

model ClaimEvidence {
  id             String        @id @default(cuid())
  claimId        String
  claim          Claim         @relation(fields: [claimId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkId        String
  chunk          DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  sourceLocation String
  excerpt        String        @db.Text
  evidenceType   EvidenceType  @default(DIRECT_QUOTE)
  createdAt      DateTime      @default(now())

  @@index([claimId])
  @@index([documentId, chunkId])
}

model HealthCheck {
  id        String   @id @default(cuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now())
}
